# Copy this file to .env and fill in your values.
# Create a free cluster at https://cloud.mongodb.com → Connect → Drivers → copy the URI.
# Replace <password> and change the database name to "qura".

MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/qura?retryWrites=true&w=majority
PORT=8000
JWT_SECRET=change_this_to_a_long_random_string
FRONTEND_URL=http://localhost:5173
